{
	"name": "n8n-nodes-feedmarkdown",
	"version": "0.1.0",
	"description": "n8n trigger node that starts a workflow for every article Feedmarkdown delivers by webhook.",
	"license": "MIT",
	"homepage": "https://feedmarkdown.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FeedMarkdown/n8n-nodes-feedmarkdown.git"
	},
	"bugs": {
		"url": "https://github.com/FeedMarkdown/n8n-nodes-feedmarkdown/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"feedmarkdown",
		"news",
		"markdown",
		"webhook"
	],
	"author": {
		"name": "AndeyM",
		"email": "andrew@webcrawlerapi.com"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [],
		"nodes": [
			"dist/nodes/FeedmarkdownTrigger/FeedmarkdownTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
